{
  "framework": null,
  "installCommand": "npm install --prefix ./milk-farm-management-master",
  "buildCommand": "npm run build:web",
  "outputDirectory": "milk-farm-management-master/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
